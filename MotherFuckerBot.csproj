<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <RootNamespace>MFBot</RootNamespace>
        <AssemblyName>MotherFuckerBot</AssemblyName>
        <LangVersion>latest</LangVersion>

        <!-- Türkçe karakterler ve tr-TR kültürü için şart. true olursa ToLower("I") patlar. -->
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <!-- _to_delete çöp kutusu: oraya atılan .cs dosyaları derlemeye girmesin -->
        <Compile Remove="_to_delete/**" />
        <None Remove="_to_delete/**" />
    </ItemGroup>

</Project>
